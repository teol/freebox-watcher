{
    "name": "freebox-watcher",
    "version": "1.0.0",
    "description": "A monitoring service for Freebox Delta that tracks uptime and alerts on downtime events",
    "main": "dist/src/index.js",
    "type": "module",
    "packageManager": "yarn@4.16.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc -p tsconfig.json",
        "start": "node --enable-source-maps dist/src/index.js",
        "dev": "tsx src/index.ts",
        "watch": "tsx watch src/index.ts",
        "test": "yarn build && DB_HOST=unit-tests.invalid node --test dist/test/*.test.js",
        "test:coverage": "yarn build && DB_HOST=unit-tests.invalid node --test --experimental-test-coverage dist/test/*.test.js",
        "test:integration": "yarn build && node --test --test-concurrency=1 dist/test/integration/*.test.js",
        "notify:test": "tsx src/scripts/sendTestNotification.ts",
        "graphql:token": "yarn build && node dist/src/scripts/generateGraphqlToken.js",
        "knex": "node --import tsx node_modules/knex/bin/cli.js",
        "db:migrate": "yarn knex migrate:latest",
        "db:rollback": "yarn knex migrate:rollback",
        "db:status": "yarn knex migrate:status",
        "db:make": "yarn knex migrate:make",
        "format": "biome format --write",
        "format:check": "biome format",
        "lint": "biome lint",
        "check": "biome check"
    },
    "keywords": [
        "freebox",
        "monitoring",
        "heartbeat",
        "uptime",
        "alerts"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@fastify/rate-limit": "^11.2.2",
        "chart.js": "^4.6.1",
        "chartjs-node-canvas": "^5.0.0",
        "cron-parser": "^5.10.4",
        "fastify": "^5.12.8",
        "graphql": "^17.1.0",
        "knex": "^3.3.0",
        "mysql2": "^3.23.3",
        "node-cron": "^4.6.0",
        "node-telegram-bot-api": "2.1.0",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "rotating-file-stream": "^3.2.10"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.7",
        "@types/node": "^26.6.6",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    }
}
