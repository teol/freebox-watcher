{
    "name": "freebox-watcher",
    "version": "1.0.0",
    "description": "A monitoring service for Freebox Delta that tracks uptime and alerts on downtime events",
    "main": "dist/src/index.js",
    "type": "module",
    "packageManager": "yarn@4.16.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc -p tsconfig.json",
        "start": "node --enable-source-maps dist/src/index.js",
        "dev": "ts-node --esm src/index.ts",
        "watch": "ts-node --esm --watch src/index.ts",
        "test": "yarn build && node --test dist/test/**/*.test.js",
        "test:coverage": "yarn build && node --test --experimental-test-coverage dist/test/**/*.test.js",
        "notify:test": "ts-node --esm src/scripts/sendTestNotification.ts",
        "db:migrate": "knex --esm migrate:latest",
        "db:rollback": "knex --esm migrate:rollback",
        "db:status": "knex --esm migrate:status",
        "db:make": "knex --esm migrate:make",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [
        "freebox",
        "monitoring",
        "heartbeat",
        "uptime",
        "alerts"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@fastify/rate-limit": "^11.0.0",
        "chart.js": "^4.5.1",
        "chartjs-node-canvas": "^5.0.0",
        "cron-parser": "^5.5.0",
        "dotenv": "^17.4.2",
        "fastify": "^5.8.5",
        "knex": "^3.2.10",
        "mysql2": "^3.22.4",
        "node-cron": "^4.2.1",
        "node-telegram-bot-api": "^0.67.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "rotating-file-stream": "^3.2.9"
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "@types/node-cron": "^3.0.11",
        "@types/node-telegram-bot-api": "^0.64.14",
        "prettier": "^3.8.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    }
}
