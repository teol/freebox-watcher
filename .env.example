# Server Configuration
PORT=3001
# Generate a secure API secret (minimum 32 characters required):
# On Linux/macOS: openssl rand -base64 48
# On any platform: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
API_SECRET=change-me-to-a-secure-random-secret

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=freebox_watcher
DB_PASSWORD=change-me-to-a-secure-password
DB_NAME=freebox_watcher

# Logging
LOG_LEVEL=info

# Monitoring Configuration
HEARTBEAT_TIMEOUT=300000
DOWNTIME_CHECK_INTERVAL=60000
DOWNTIME_CONFIRMATION_DELAY=1800000

# Telegram Notifications (optional)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Get chat ID by messaging your bot and visiting https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=
# Set to 'false' to disable new device Telegram notifications (default: enabled when Telegram is configured)
NEW_DEVICE_NOTIFICATION_ENABLED=

# Connection quality monitoring (Telegram alerts on fiber signal, line rate, media and reboots)
# Set to 'false' to disable it (default: enabled)
QUALITY_MONITOR_ENABLED=
# Interval between two checks in milliseconds, also the analysis window length (default: 900000 = 15 minutes)
QUALITY_CHECK_INTERVAL=900000
# Baseline period the analysis window is compared to, in hours (default: 24)
QUALITY_BASELINE_HOURS=24
# Fiber RX power thresholds in dBm (defaults: warning -25, critical -27)
QUALITY_SFP_RX_WARNING_DBM=-25
QUALITY_SFP_RX_CRITICAL_DBM=-27
# Fiber RX/TX power drop compared to the baseline that raises a warning, in dB (default: 2)
QUALITY_SFP_DROP_DB=2
# Line rate drop compared to the baseline that raises a warning, in percent (default: 20)
QUALITY_BANDWIDTH_DROP_PERCENT=20

# Discord Charts (optional)
# Discord webhook URL shared by all chart services
# Create a webhook in Discord: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# Network rate chart (always enabled when DISCORD_WEBHOOK_URL is set)
# CRON schedule for network chart generation (default: "0 5 * * *" = daily at 5:00 AM)
# Examples: "0 */4 * * *" = every 4 hours, "0 */6 * * *" = every 6 hours
CRON_SCHEDULE=

# Connected devices chart (opt-in)
# Set to 'true' to enable the connected devices chart on Discord
DEVICES_CHART_ENABLED=false
# CRON schedule for devices chart generation (default: "0 5 * * *" = daily at 5:00 AM)
DEVICES_CRON_SCHEDULE=

# GraphQL API (optional, read-only)
# Disabled by default. Set to 'true' to expose POST /api/graphql
GRAPHQL_ENABLED=false
# SHA-256 hash of the GraphQL Bearer token (required when enabled)
# Generate a token and its hash with: yarn graphql:token
GRAPHQL_API_TOKEN_HASH=
# Max GraphQL requests per minute per IP address (default: 60)
GRAPHQL_RATE_LIMIT=60
